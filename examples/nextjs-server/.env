# Settings for Rotion that are safe to commit. Put NOTION_TOKEN and
# NOTION_DATABASE_ID in .env.local.

# Download images and files outside public/, because next start serves only
# the files that were in public/ when it started. The route handlers in
# app/images and app/files serve this directory.
ROTION_DOCROOT=storage

# Fetch pages again when their last_edited_time changes, and databases after
# ROTION_CACHE_AVAILABLE_DURATION, so edits in Notion reach the running server.
ROTION_INCREMENTAL_CACHE=true
